config UART_HPMICRO
	bool "HPMicro UART driver"
	default y
	depends on DT_HAS_HPMICRO_HPM_UART_ENABLED
	depends on CLOCK_CONTROL
	depends on HAS_HPMSDK_UART
	select PINCTRL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select USE_HPMSDK_UART
	help
	  Enable the UART driver for HPMicro UART controllers. Polling is
	  always available, and interrupt-driven operation can be enabled
	  with CONFIG_UART_INTERRUPT_DRIVEN.
